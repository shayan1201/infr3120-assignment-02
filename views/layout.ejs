<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <!-- Bootstrap for the main page layout and styling -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Font Awesome for the social media icons -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <!-- Shared navigation for all pages -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="/">Shayan's Portfolio</a>

                <div class="navbar-nav">
                    <a class="nav-link" href="/">Home</a>
                    <a class="nav-link" href="/about">About Me</a>
                    <a class="nav-link" href="/projects">Projects</a>
                    <a class="nav-link" href="/contact">Contact Me</a>
                </div>
            </div>
        </nav>
    </header>

    <!-- Each page's EJS content is inserted here -->
    <main class="container py-5">
        <%- body %>
    </main>

    <!-- Shared footer with my social links -->
    <footer class="bg-dark text-white text-center py-4">
        <p>© 2026 Shayan Hussain</p>

        <a href="https://github.com/shayan1201" class="text-white me-3">
            <i class="fa-brands fa-github"></i> GitHub
        </a>

        <a href="https://www.linkedin.com/" class="text-white">
            <i class="fa-brands fa-linkedin"></i> LinkedIn
        </a>
    </footer>

</body>
</html>